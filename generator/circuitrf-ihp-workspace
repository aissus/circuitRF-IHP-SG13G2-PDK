#!/bin/bash
# circuitrf-ihp-workspace <dir>
# A new circuitRF workspace on the IHP SG13G2 kit: the kit's device library is
# referenced (from this repository's kit/), and the IHP technology is copied in,
# because a workspace owns its technology. Open <dir> in circuitRF afterwards.
# The IHP Open PDK itself is referenced too, as an imported PDK: it is what
# File > Manage Libraries and the Library palette list. circuitRF imports it
# when the workspace first opens, and adds its decisions (model worker,
# corners) to the .cws then. The Provider must be the importer's own kit name,
# the PDK folder's name: circuitRF registers the parts under the Provider and
# the palette looks them up under the folder name, so any other name leaves
# every part unresolved (generic symbols, nothing to simulate).
set -e
KIT=${IHP_KIT:-$(cd "$(dirname "$(readlink -f "$0")")/../kit/IHP_SG13G2" && pwd)}
PDK=${IHP_PDK:-/foss/pdks/ihp-sg13g2}
[ -n "$1" ] || { echo "usage: circuitrf-ihp-workspace <dir>" >&2; exit 1; }
[ -e "$1/.cws" ] && { echo "$1 is already a workspace" >&2; exit 1; }
mkdir -p "$1/tech"
cp "$KIT/tech/IHP_SG13G2.ctech" "$1/tech/"
# The kit is named relative to the workspace, so the two can move or be shared together.
REL=$(realpath --relative-to="$1" "$KIT")
cat > "$1/.cws" <<EOF
{
  "FormatVersion": 2,
  "LibraryRefs": ["$REL"],
  "ReferencedWorkspaces": [{"Alias": "IHP_SG13G2", "Path": "$REL/.cws"}],
  "KnownFiles": [],
  "DefaultTechRef": "tech/IHP_SG13G2.ctech",
  "PdkRefs": [{"Path": "$PDK", "Provider": "$(basename "$PDK")", "TranslationVersion": 5}]
}
EOF
# Its declaration of the kit's PCells, in the folder circuitRF would otherwise fill for the PdkRef
D="$1/$(basename "$PDK")-pcells"; mkdir -p "$D"
printf '{\n  "schemaVersion": 1,\n  "entry": "%s"\n}\n' "$(realpath --relative-to="$D" "$KIT/pcells/kit_entry.py")" > "$D/pcell-generators.json"
echo "workspace $1: IHP SG13G2 technology, devices from $REL, IHP Open PDK from $PDK"
