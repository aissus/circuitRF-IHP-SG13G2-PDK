# The image the kit is built and checked in:
#     apptainer build --fakeroot kit.sif kit.def
# The base already holds what the generator calls: ngspice, Xyce, OpenVAF, VACASK's VBIC
# and the IHP SG13G2 PDK. This adds circuitRF from its release.

Bootstrap: docker
From: hpretl/iic-osic-tools:2026.09

%environment
    # hwloc's GL plugin opens every X display on the host looking for GPUs and can block
    # forever on one that never answers, which hangs MPI programs (Xyce, Palace).
    export HWLOC_COMPONENTS=-gl
    export CRF_VERILOGA_COMPILER=/foss/tools/bin/openvaf
    export CIRCUITRF_PALACE=/opt/circuitrf-palace

%post
    set -eux
    # The kit is generated from, and validated against, this PDK commit.
    test "$(cat /foss/pdks/ihp-sg13g2/COMMIT)" = c271a7e97a7bab201c1d0a399215969d2ee19573
    curl -fsSL https://github.com/potatobeanradio/circuitRF/releases/download/1.7.5/circuitRF-1.7.5-linux-x64.tar.gz \
        | tar -xz -C /opt
    ln -s /opt/circuitRF-1.7.5/app-1.7.5/circuitRF /usr/local/bin/circuitrf
    # Fails the build if the runtime is short of a library.
    circuitrf --version

    # The base's Palace, for circuitRF's 3D runs. circuitRF runs only the Palace commit it validated and
    # knows it by the hash --version prints; the base built that commit from its tag, so its Palace prints
    # the tag instead. The wrapper reports the hash the base built it from (another commit is still
    # refused). A solve (-np N --launcher L config.json) runs the Palace binary under that launcher, at most
    # PALACE_NP ranks (default 16): circuitRF asks for one per core, more than a shared machine or a job
    # should take. Not through the base's run_palace or palace scripts: those start mpirun inside mpirun.
    cat > /opt/circuitrf-palace <<'EOF'
#!/bin/bash
P=/foss/tools/bin/palace
case " $* " in *" --version "*)
    h=$(awk '$1 == "palace" {print substr($2, 1, 7)}' /foss/tools/palace/SOURCES)
    "$P" "$@" | sed "s/^Palace version: v[0-9.]*$/Palace version: $h/"
    exit "${PIPESTATUS[0]}";;
esac
if [ "$1" = -np ] && [ "$3" = --launcher ] && [ $# -eq 5 ]; then
    n=$2; [ "$n" -gt "${PALACE_NP:-16}" ] && n=${PALACE_NP:-16}
    exec "$4" -n "$n" /foss/tools/bin/palace-x86_64.bin "$5"
fi
exec "$P" "$@"
EOF
    chmod +x /opt/circuitrf-palace
