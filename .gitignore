# Build output: generator/build.sh writes it; the VBIC-derived .osdi in it are not to be committed.
kit/
# The release archives ci/build-release.sh packs from it.
dist/
# The image (kit.def builds it) and the container's home directory.
*.sif
.home/
# circuitRF's per-machine and per-run files.
**/results/*
!**/results/*.cdd
.generated-cells/
.cwsuser
# circuitRF's open-workspace lock (user, host, process) and its write probe.
.crf-open.json
.crf-write-probe-*
# circuitRF's MCP server's scratch folder.
.circuitrf-scratch/
# Made by generator/build.sh for the kit it builds.
examples/tech/
examples/harmonica/
