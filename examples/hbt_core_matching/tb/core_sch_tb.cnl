VBE = 0.88
VCC = 1.5
; extracted from CORE

define cap_cmim (PLUS MINUS)
  parameters w=7e-06  l=7e-06  corner=0  T=27
  cap_carea = corner==1 ? 0.9*1.5E-15 : (corner==2 ? 1.1*1.5E-15 : 1.5E-15)
  Cmim = (cap_carea*(w*1e6)*(l*1e6) + 40E-18*2*(w*1e6+l*1e6))*(1 + 3.6E-6*(T-27) + 2E-9*(T-27)^2)
  R:R1  PLUS  n1  R=0.055
  C:C1  n1  MINUS  C=Cmim
end cap_cmim

