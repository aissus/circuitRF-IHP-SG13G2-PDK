VBE = 0.88
VCC = 1.5
; Co-simulation of 'core_i': the layout's 10-port with each cut-out instance's model back on its ports (written
; by circuitRF from the run). Each port stands at a cut instance's pin face, against the run's ground, and the
; instance's model goes back on those ports by pin name.
; BOARD's ports: p1 is 1, p2 is 2, p3 is 3, p4 is Q1.C, p5 is Q1.B, p6 is Q1.E, p7 is C1.PLUS, p8 is C1.MINUS, p9 is C2.PLUS, p10 is C2.MINUS.
; Q1: npn13G2 cut out of the layout, its model's terminals on its pins by name.
; C1: cmim cut out of the layout, its model's terminals on its pins by name.
; C2: cmim cut out of the layout, its model's terminals on its pins by name.

define cap_cmim (PLUS MINUS)
  parameters w=7e-06  l=7e-06  corner=0  T=27
  cap_carea = corner==1 ? 0.9*1.5E-15 : (corner==2 ? 1.1*1.5E-15 : 1.5E-15)
  Cmim = (cap_carea*(w*1e6)*(l*1e6) + 40E-18*2*(w*1e6+l*1e6))*(1 + 3.6E-6*(T-27) + 2E-9*(T-27)^2)
  R:R1  PLUS  n1  R=0.055
  C:C1  n1  MINUS  C=Cmim
end cap_cmim

define IND_BIG (LA LB)
  SnP:S1  LA  LB  NumPorts=2  File="../results/ind_big.s2p"
end IND_BIG

define npn13G2 (c b e bn)
  parameters Nx=1  corner=0  T=27  dtemp=0  selft=1
  vbic_cje = corner==1 ? 0.83 : (corner==2 ? 1.17 : 1.0)
  vbic_cjc = corner==1 ? 0.87 : (corner==2 ? 1.13 : 1.0)
  vbic_cjcp = corner==1 ? 0.89 : (corner==2 ? 1.11 : 1.0)
  vbic_is = corner==1 ? 1.26 : (corner==2 ? 0.74 : 1.0)
  vbic_ibei = corner==1 ? 0.67 : (corner==2 ? 1.33 : 1.0)
  vbic_re = corner==1 ? 0.73 : (corner==2 ? 1.27 : 1.0)
  vbic_rcx = corner==1 ? 0.79 : (corner==2 ? 1.21 : 1.0)
  vbic_rbx = corner==1 ? 0.88 : (corner==2 ? 1.12 : 1.0)
  vbic_tf = corner==1 ? 0.89 : (corner==2 ? 1.11 : 1.0)
  Ny = 1
  le = 0.96e-6
  we = 0.12e-6
  El = le*1e6
  sw_nqs = 0
  VerilogA:Q1  c  b  e  s1  t  File="../../../kit/IHP_SG13G2/models/osdi/vbic_1p3_5t.osdi"  Pins=5  tnom=27  cbeo=8.00E-16*(Nx*0.25)^0.975  cje=8.418E-15*(Nx*0.25)^0.975*vbic_cje  pe=0.92  me=0.12  aje=-0.50  wbe=1.00  cbco=2.36E-15*(Nx*0.25)  cjc=1.53E-15*(Nx*0.25)*vbic_cjc  pc=0.558  mc=0.12  ajc=-0.50  cjep=3.56E-15*(Nx*0.25)*vbic_cjc  cjcp=4.56E-15*(Nx*0.25)^0.8*vbic_cjcp  ps=0.46  ms=0.23  ajs=-0.50  fc=0.80  vef=189  ver=5.3  is=4.81E-17*(Nx*0.25)*vbic_is  nf=1.018  ibei=1.9E-19*(Nx*0.25)*vbic_ibei  nei=1.066  iben=4.00E-16*(Nx*0.25)  nen=2.00  ikf=0.009*(Nx*0.25)  nr=1.01  ibci=1.50E-20*(Nx*0.25)  nci=1.103  ibcn=1.00E-15*(Nx*0.25)  ncn=1.96  ikr=0.01*(Nx*0.25)  wsp=1  isp=4.00E-20*(Nx*0.25)  nfp=1.04  ibcip=2.00E-15*(Nx*0.25)^0.7  ncip=1.00  ibcnp=5.00E-15*(Nx*0.25)  ncnp=1.50  ikp=.00E-04*(Nx*0.25)  ibeip=4.00E-19*(Nx*0.25)  ibenp=2.00E-14*(Nx*0.25)  re=7.13E+00*(4/Nx)^1*vbic_re  rcx=1.3E+01*(4/Nx)^1*vbic_rcx  rci=1.29E+01*(4/Nx)^1  qco=1.00E-18  vo=0.80  gamm=2.25E-14  hrcf=1000  rbx=6.93E+00*(4/Nx)^0.95*vbic_rbx  rbi=2.20E+01*(4/Nx)^0.95*vbic_rbx  rbp=5.5*(4/Nx)  rs=1  avc1=2.40  avc2=10.81  tf=2.08E-13*vbic_tf*((T+273)/300)^0.7  qtf=1.00E-18  xtf=10.0  vtf=20.0  itf=0.585*(Nx*0.25)  tr=3.50E-13  td=sw_nqs*2.80E-13*(Nx*0.25)^0  cth=1.60E-12*(Nx*0.25)^0.95  rth=1*selft*3.26E+03*(4/Nx)^0.9  ea=1.056  eaie=1.056  eaic=1.12  eais=1.12  eane=1.12  eanc=1.12  eans=1.12  xre=-0.42  xrb=0.90  xrc=0.245  xrs=1.50  xvo=1.50  xis=2.30  xii=3.30  xin=3.30  tnf=0.00015  tavc=-0.00188  kfn=6.00E-9*(4/Nx)  afn=1.80  bfn=1.00  Temp=T+dtemp
  R:Rsub  s1  bn  R=300+100*Nx
  C:Csub  s1  bn  C=2.30E-14-(1.50E-15*Nx)
  R:Rt  t  0  R=1e9
end npn13G2

