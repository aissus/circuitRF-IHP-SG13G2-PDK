   "Parameters": [
    {
     "Name": "L_mom_pH",
     "Expression": "imag((50*(1+SP1.S(1,1))/(1-SP1.S(1,1))))/(2*pi*freq)*1e12",
     "Unit": "",
     "ShowOnSchematic": true,
     "Dimension": "None"
    },
    {
     "Name": "Q_mom",
     "Expression": "imag((50*(1+SP1.S(1,1))/(1-SP1.S(1,1))))/real((50*(1+SP1.S(1,1))/(1-SP1.S(1,1))))",
     "Unit": "",
     "ShowOnSchematic": true,
     "Dimension": "None"
    },
    {
     "Name": "L_palace_pH",
     "Expression": "imag((2*50*(1-SP1.S(2,2)*SP1.S(3,3)+SP1.S(2,3)*SP1.S(3,2)-SP1.S(2,3)-SP1.S(3,2))/((1-SP1.S(2,2))*(1-SP1.S(3,3))-SP1.S(2,3)*SP1.S(3,2))))/(2*pi*freq)*1e12",
     "Unit": "",
     "ShowOnSchematic": true,
     "Dimension": "None"
    },
    {
     "Name": "Q_palace",
     "Expression": "imag((2*50*(1-SP1.S(2,2)*SP1.S(3,3)+SP1.S(2,3)*SP1.S(3,2)-SP1.S(2,3)-SP1.S(3,2))/((1-SP1.S(2,2))*(1-SP1.S(3,3))-SP1.S(2,3)*SP1.S(3,2))))/real((2*50*(1-SP1.S(2,2)*SP1.S(3,3)+SP1.S(2,3)*SP1.S(3,2)-SP1.S(2,3)-SP1.S(3,2))/((1-SP1.S(2,2))*(1-SP1.S(3,3))-SP1.S(2,3)*SP1.S(3,2))))",
     "Unit": "",
     "ShowOnSchematic": true,
     "Dimension": "None"
    },
    {
     "Name": "L_emerge_pH",
     "Expression": "imag((2*50*(1-SP1.S(4,4)*SP1.S(5,5)+SP1.S(4,5)*SP1.S(5,4)-SP1.S(4,5)-SP1.S(5,4))/((1-SP1.S(4,4))*(1-SP1.S(5,5))-SP1.S(4,5)*SP1.S(5,4))))/(2*pi*freq)*1e12",
     "Unit": "",
     "ShowOnSchematic": true,
     "Dimension": "None"
    },
    {
     "Name": "Q_emerge",
     "Expression": "imag((2*50*(1-SP1.S(4,4)*SP1.S(5,5)+SP1.S(4,5)*SP1.S(5,4)-SP1.S(4,5)-SP1.S(5,4))/((1-SP1.S(4,4))*(1-SP1.S(5,5))-SP1.S(4,5)*SP1.S(5,4))))/real((2*50*(1-SP1.S(4,4)*SP1.S(5,5)+SP1.S(4,5)*SP1.S(5,4)-SP1.S(4,5)-SP1.S(5,4))/((1-SP1.S(4,4))*(1-SP1.S(5,5))-SP1.S(4,5)*SP1.S(5,4))))",
     "Unit": "",
     "ShowOnSchematic": true,
